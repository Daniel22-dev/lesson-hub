{
  "schema": "garp27-core-contract-v1",
  "garpVersion": "2.7",
  "consolidationRevision": "2026-09-23-r2",
  "activeAuthority": "GARP-2.7",
  "legacyBaselines": [
    "GARP-2.5.1",
    "GARP-2.6"
  ],
  "serverPhase": "DEFERRED_BY_OWNER_DECISION",
  "exitCodes": {
    "PASS": 0,
    "FAIL": 1,
    "HARNESS_ERROR": 2,
    "NOT_TESTED": 3
  },
  "requiredPolicySections": [
    "identity",
    "requestApiAi",
    "egress",
    "files",
    "dataLifecycle",
    "release",
    "inventory",
    "securityHealth",
    "incident",
    "recovery"
  ],
  "forbiddenPlaceholderValues": [
    "todo",
    "tbd",
    "placeholder",
    "changeme",
    "example",
    "unknown",
    "explicit-app-policy"
  ],
  "assuranceAxes": [
    "presence",
    "health",
    "effectiveness",
    "evidenceFreshness"
  ],
  "assuranceGood": {
    "presence": "PRESENT",
    "health": "HEALTHY",
    "effectiveness": "PASS",
    "evidenceFreshness": "FRESH"
  },
  "autoPatchStates": [
    "PREPARED",
    "VALIDATED",
    "COMMITTED",
    "ROLLED_BACK"
  ],
  "liveClaimRequiresRuntimeEvidence": true,
  "forbiddenPlaceholderSubstrings": [
    "replace-with",
    "replace_with",
    "replace me",
    "replace-me",
    "change-me",
    "change_me",
    "changeme",
    "placeholder",
    "todo",
    "tbd",
    "example",
    "unknown"
  ],
  "policyValidation": {
    "defaultInventory": "MASTER/INVENTORY/ecosystem-apps.json",
    "forbiddenAppVersions": [
      "0.0.0"
    ],
    "requireSemver": true,
    "requiredSectionSemantics": {
      "identity": {
        "anyOf": [
          "rule",
          "controls",
          "authentication",
          "authorization",
          "session",
          "standaloneProfile",
          "schoolProfile",
          "provider",
          "roles"
        ],
        "minMatches": 1
      },
      "requestApiAi": {
        "anyOf": [
          "registry",
          "registeredOperations",
          "controls",
          "operations",
          "agentic",
          "requestPolicy",
          "aiPolicy",
          "maxCallsPerOperation",
          "modelPolicy"
        ],
        "minMatches": 1
      },
      "egress": {
        "anyOf": [
          "standalone",
          "school",
          "crossApp",
          "allowedDestinations",
          "allowedEgress",
          "defaultDeny",
          "networkPolicy",
          "providerEgress"
        ],
        "minMatches": 1
      },
      "files": {
        "anyOf": [
          "currentBoundary",
          "serverBoundary",
          "uploads",
          "imports",
          "uploadPolicy",
          "importPolicy",
          "quarantine",
          "allowedMimeTypes",
          "maxBytes"
        ],
        "minMatches": 1
      },
      "dataLifecycle": {
        "anyOf": [
          "classification",
          "storage",
          "retention",
          "deletion",
          "retentionDays",
          "temporaryDataTtlMinutes",
          "securityLogContentPolicy"
        ],
        "minMatches": 1
      },
      "release": {
        "anyOf": [
          "activeAuthority",
          "promotion",
          "publicAssurance",
          "signing",
          "signedReleaseRequired",
          "antiRollbackRequired",
          "rollback",
          "releasePolicy"
        ],
        "minMatches": 1
      },
      "inventory": {
        "anyOf": [
          "source",
          "architecturePolicy",
          "changeRule",
          "components",
          "dependencies",
          "inventoryPolicy"
        ],
        "minMatches": 1
      },
      "securityHealth": {
        "anyOf": [
          "localCi",
          "live",
          "failureMode",
          "checks",
          "monitoring",
          "assurance",
          "healthPolicy"
        ],
        "minMatches": 1
      },
      "incident": {
        "anyOf": [
          "current",
          "future",
          "response",
          "escalation",
          "contacts",
          "incidentPolicy"
        ],
        "minMatches": 1
      },
      "recovery": {
        "anyOf": [
          "current",
          "future",
          "rollback",
          "restore",
          "backup",
          "recoveryPolicy"
        ],
        "minMatches": 1
      }
    }
  }
}
