# Lesson Hub Server — kopírujte pouze na chráněný server, nikdy ne do klienta.
LESSON_HUB_SERVER_HOST=127.0.0.1
LESSON_HUB_SERVER_PORT=8790
LESSON_HUB_ALLOWED_ORIGINS=https://ai.example-school.cz
LESSON_HUB_BACKUP_ENABLED=true
LESSON_HUB_MAIL_MODE=disabled
LESSON_HUB_SMTP_REQUIRE_TLS=true
# LESSON_HUB_SMTP_HOST=
# LESSON_HUB_SMTP_USER=
# LESSON_HUB_SMTP_PASSWORD=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# Shared only between the central GHRAB gateway and the loopback Lesson Hub service.
# LESSON_HUB_GHRAB_UPSTREAM_SECRET=
# Generujte CSPRNG, např.: openssl rand -hex 32
# Pokud je gateway integrace zapnuta, použijte 256bitový high-entropy secret: přesně 64 hex znaků nebo 43–86 base64url znaků s dostatečnou rozmanitostí. Slabá, placeholder, krátká nebo prázdná hodnota zastaví start.
