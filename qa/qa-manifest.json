{
  "standard": "GHRAB-QA-1.0.2",
  "appId": "lesson-hub",
  "appName": "Lesson Hub",
  "appVersion": "1.1.2",
  "entryPoint": "dist/index.html",
  "serveRoot": "dist",
  "buildRoot": "dist",
  "installCommand": "npm ci --no-fund",
  "buildCommand": "npm run build",
  "testCommand": "npm test",
  "headlessCommand": "npm run test:headless",
  "auditCommand": "npm audit --audit-level=high",
  "features": {
    "pwa": true,
    "ai": false,
    "centralAccessGuard": true,
    "fileExport": true,
    "studentRuntime": false,
    "teacherRuntime": true,
    "localStorage": true,
    "serviceWorker": true,
    "serverApi": true,
    "authentication": true,
    "synchronization": true
  },
  "requiredViewports": [
    {
      "width": 360,
      "height": 800
    },
    {
      "width": 412,
      "height": 915
    },
    {
      "width": 768,
      "height": 1024
    },
    {
      "width": 1366,
      "height": 768
    },
    {
      "width": 1920,
      "height": 1080
    }
  ],
  "versionChecks": [
    {
      "file": "src/core/release.js",
      "regex": "version:\\s*['\\\"]([0-9.]+)['\\\"]",
      "expected": "1.1.2"
    },
    {
      "file": "dist/build-info.json",
      "regex": "\\\"version\\\"\\s*:\\s*\\\"([0-9.]+)\\\"",
      "expected": "1.1.2"
    },
    {
      "file": "dist/sw.js",
      "regex": "lesson-hub-pwa-v([0-9.]+)",
      "expected": "1.1.2"
    }
  ],
  "pwaTargets": [
    {
      "id": "lesson-hub",
      "root": "dist",
      "manifest": "manifest.webmanifest",
      "serviceWorker": "sw.js",
      "cachePrefix": "lesson-hub-pwa-v"
    }
  ],
  "security": {
    "allowedEmails": [],
    "requiresCsvFormulaProtection": false
  },
  "compatibility": {
    "runtimeSourceRoots": [
      "src",
      "public"
    ],
    "disallowRegexLookbehind": true
  }
}
